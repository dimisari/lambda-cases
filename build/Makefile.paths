
src := ../src
test := ../test
examples := ../examples
local_stuff := $(HOME)/.local/share/lcc

lcc_exec := $(HOME)/.local/bin/lcc
rules_exec := grules

p_imps := $(src)/Predefined/
p_imp_pr := $(p_imps)/Predefined.hs
p_imp_ops := $(p_imps)/Operators.hs

p_imps_cp := $(local_stuff)/Predefined/
p_imp_cp_pr := $(p_imps_cp)/Predefined.hs
p_imp_cp_ops := $(p_imps_cp)/Operators.hs

# test input

test_ins := $(test)/inputs

test_prog_dir := $(test_ins)/programs
test_ins_grs := $(test_ins)/grammar_rules

test_prog_files := $(shell ls $(test_prog_dir))
test_rule_files := $(shell ls $(test_ins_grs))

test_prog_pattern := $(test_prog_dir)/%.lc

# test output

test_outs := $(test)/outputs

test_rules_out_dir := $(test_outs)/grammar_rules_hs

test_hs_prog_pattern := $(test_outs)/programs_hs/%.hs
test_hs_rule_pattern := $(test_rules_out_dir)/%.hs
test_exec_pattern := $(test_outs)/compiled_progs/%.out

test_hs_prog_files := \
  $(patsubst %.lc, $(test_hs_prog_pattern), $(test_prog_files))
hs_grs := $(patsubst %.txt, $(test_hs_rule_pattern), $(test_rule_files))
execs := $(patsubst %.lc, $(test_exec_pattern), $(test_prog_files))
